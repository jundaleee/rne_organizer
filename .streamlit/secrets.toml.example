# Streamlit Community Cloud에 배포할 때: 앱 설정 > Secrets 에 아래 내용을 붙여넣는다.
# 로컬에서 쓸 땐 이 파일을 복사해서 .streamlit/secrets.toml 로 저장한다 (역시 .gitignore 처리됨).

ANTHROPIC_API_KEY = "sk-ant-여기에-실제-키-입력"

# (선택) 데이터 입력 즉시 GitHub에 자동 커밋하는 기능을 쓰려면 채운다.
# 비워두면 해당 기능은 조용히 꺼진 채로 동작한다.
[github]
token = "ghp_여기에-Personal-Access-Token"
repo = "jundaleee/rne_organizer"
